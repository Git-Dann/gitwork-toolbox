{
  "name": "gitwork-toolbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/build-design-md.mjs",
    "dev": "next dev",
    "build": "npm run data && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "discover": "node scripts/discover.mjs",
    "assess": "node scripts/assess.mjs",
    "foundry-sync": "node scripts/foundry-sync.mjs",
    "icons": "node scripts/fetch-icons.mjs",
    "previews": "node scripts/fetch-previews.mjs && node scripts/shrink-previews.mjs",
    "shrink": "node scripts/shrink-previews.mjs"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3"
  }
}
